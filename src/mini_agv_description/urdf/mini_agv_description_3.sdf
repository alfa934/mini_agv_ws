          </geometry>
        </collision>
        <collision name='wheel_hub_assy_link_collision_1'>
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://mini_agv_description/assets/8mm_flange_hub.stl</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name='wheel_hub_assy_link_visual'>
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://mini_agv_description/assets/wheel.stl</uri>
            </mesh>
          </geometry>
          <material>
            <diffuse>0.808823764 0.808823764 0.808823764 1</diffuse>
            <ambient>0.808823764 0.808823764 0.808823764 1</ambient>
          </material>
        </visual>
        <visual name='wheel_hub_assy_link_visual_1'>
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://mini_agv_description/assets/8mm_flange_hub.stl</uri>
            </mesh>
          </geometry>
          <material>
            <diffuse>0.769607484 1 1 1</diffuse>
            <ambient>0.769607484 1 1 1</ambient>
          </material>
        </visual>
      </link>

      <joint name='wheel_2_joint' type='revolute'>
        <pose relative_to='base_assy_link'>-0.05640339999980909 0.033132403951704428 -0.0129693 -1.5708 1.1102230246251565e-16 1.5707953071795873</pose>
        <parent>base_assy_link</parent>
        <child>wheel_hub_assy_2_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <effort>10</effort>
            <velocity>10</velocity>
            <lower>-inf</lower>
            <upper>inf</upper>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>

      <link name='wheel_hub_assy_2_link'>
        <pose relative_to='wheel_2_joint'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0.0084338399999999997 0 0 0</pose>
          <mass>0.177204</mass>
          <inertia>
            <ixx>0.000154537</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.000154537</iyy>
            <iyz>0</iyz>
            <izz>0.00028956400000000002</izz>
          </inertia>
        </inertial>
        <collision name='wheel_hub_assy_2_link_collision'>
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://mini_agv_description/assets/wheel.stl</uri>
            </mesh>
          </geometry>
        </collision>
        <collision name='wheel_hub_assy_2_link_collision_1'>
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://mini_agv_description/assets/8mm_flange_hub.stl</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name='wheel_hub_assy_2_link_visual'>
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://mini_agv_description/assets/wheel.stl</uri>
            </mesh>
          </geometry>
          <material>
            <diffuse>0.808823764 0.808823764 0.808823764 1</diffuse>
            <ambient>0.808823764 0.808823764 0.808823764 1</ambient>
          </material>
        </visual>
        <visual name='wheel_hub_assy_2_link_visual_1'>
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://mini_agv_description/assets/8mm_flange_hub.stl</uri>
            </mesh>
          </geometry>
          <material>
            <diffuse>0.769607484 1 1 1</diffuse>
            <ambient>0.769607484 1 1 1</ambient>
          </material>
        </visual>
      </link>

      <!-- Frames -->
      <frame name='caster_1_joint' attached_to='base_assy_link'>
        <pose>0.23189699999999999 0.31813200000000003 0.0100307 0 0 1.5708</pose>
      </frame>
      <frame name='caster_frame_link' attached_to='caster_1_joint'>
        <pose>0 0 0 0 0 0</pose>
      </frame>
      <frame name='caster_2_joint' attached_to='base_assy_link'>
        <pose>-0.0081034399999999999 0.31813200000000003 0.0100307 0 0 1.5708</pose>
      </frame>
      <frame name='caster_frame_2_link' attached_to='caster_2_joint'>
        <pose>0 0 0 0 0 0</pose>
      </frame>
      <frame name='lidar_joint' attached_to='base_assy_link'>
        <pose>0.111897 0.15313199999999999 0.032030700000000002 3.1415899999999999 0 1.5708</pose>
      </frame>
      <frame name='velodyne_lidar_link' attached_to='lidar_joint'>
        <pose>0 0 0 0 0 0</pose>
      </frame>
      <frame name='motor_1_joint' attached_to='base_assy_link'>
        <pose>0.25189699999999998 0.033132300000000003 0.0100307 0 0 1.5708</pose>
      </frame>
      <frame name='pg36_assy_link' attached_to='motor_1_joint'>
        <pose>0 0 0 0 0 0</pose>
      </frame>
      <frame name='motor_2_joint' attached_to='base_assy_link'>
        <pose>-0.028103400000000001 0.033132300000000003 0.0100307 0 0 -1.5708</pose>
      </frame>
      <frame name='pg36_assy_2_link' attached_to='motor_2_joint'>
        <pose>0 0 0 0 0 0</pose>
      </frame>

      <!-- ==================== IMU ==================== -->
      <joint name='imu_joint' type='fixed'>
        <parent>base_assy_link</parent>
        <child>imu_link</child>
        <pose relative_to="base_assy_link">0.111897 0.153132 0.03 0 0 0</pose>
      </joint>

      <link name='imu_link'>
        <pose relative_to="imu_joint"/>
        <visual name="imu_link_visual">
          <geometry>
            <box><size>0.1 0.1 0.1</size></box>
          </geometry>
        </visual>
        <collision name="imu_link_collision">
          <geometry>
            <box><size>0.1 0.1 0.1</size></box>
          </geometry>
        </collision>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001666667</ixx>
            <iyy>0.0001666667</iyy>
            <izz>0.0001666667</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <sensor name="imu_sensor" type="imu">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <visualize>true</visualize>
          <topic>demo/imu</topic>
          <gz_frame_id>imu_link</gz_frame_id>
          <imu>
            <angular_velocity>
              <x>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>2e-4</stddev>
                  <bias_mean>0.0000075</bias_mean>
                  <bias_stddev>0.0000008</bias_stddev>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>2e-4</stddev>
                  <bias_mean>0.0000075</bias_mean>
                  <bias_stddev>0.0000008</bias_stddev>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>2e-4</stddev>
                  <bias_mean>0.0000075</bias_mean>
                  <bias_stddev>0.0000008</bias_stddev>
                </noise>
              </z>
            </angular_velocity>
            <linear_acceleration>
              <x>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>1.7e-2</stddev>
                  <bias_mean>0.1</bias_mean>
                  <bias_stddev>0.001</bias_stddev>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>1.7e-2</stddev>
                  <bias_mean>0.1</bias_mean>
                  <bias_stddev>0.001</bias_stddev>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>1.7e-2</stddev>
                  <bias_mean>0.1</bias_mean>
                  <bias_stddev>0.001</bias_stddev>
                </noise>
              </z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>

      <!-- ==================== DIFF DRIVE PLUGIN ==================== -->
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>wheel_2_joint</left_joint>
        <right_joint>wheel_1_joint</right_joint>
        <wheel_separation>0.3366</wheel_separation>
        <wheel_radius>0.05675</wheel_radius>
        <max_linear_acceleration>0.1</max_linear_acceleration>
        <topic>/demo/cmd_vel</topic>
        <odom_topic>/demo/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>   <!-- odometry published in base_link frame -->

      </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
      </plugin>

    </model>
  </sdf>